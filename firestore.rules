rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validProgress(d) {
      return d.userId == request.auth.uid
        && d.litDistricts is list && d.litDistricts.size() <= 3
        && d.litDistricts.hasOnly(['12', '11', '4'])
        && d.visited is list && d.visited.size() <= 13
        && (d.finalMessage == null || d.finalMessage in ['rebelion', 'memoria'])
        && (d.completedAt == null || d.completedAt is int);
    }

    match /progress/{userId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && validProgress(request.resource.data);
    }

    // Una copia activa por cuenta. El cliente conserva el historial completo en el snapshot.
    match /users/{userId}/runs/{slot} {
      allow read, delete: if request.auth != null && request.auth.uid == userId && slot == 'active';
      allow create, update: if request.auth != null && request.auth.uid == userId && slot == 'active'
        && request.resource.data.keys().hasOnly(['userId', 'snapshot', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.snapshot.version == 1
        && request.resource.data.snapshot.id is string
        && request.resource.data.snapshot.id.size() <= 80
        && request.resource.data.snapshot.phase in ['reaping', 'preparation', 'arena', 'ended']
        && request.resource.data.snapshot.revision is int
        && request.resource.data.snapshot.revision >= 0
        && request.resource.data.snapshot.revision <= 26
        && request.resource.data.snapshot.turn is int
        && request.resource.data.snapshot.turn >= 0
        && request.resource.data.snapshot.turn <= 24
        && request.resource.data.snapshot.tributes is list
        && request.resource.data.snapshot.tributes.size() == 24
        && request.resource.data.snapshot.events is list
        && request.resource.data.snapshot.events.size() <= 1600
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
